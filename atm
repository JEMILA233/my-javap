import java.util.Scanner;
public class Atmsimulation {
static double balance = 1000.00;

public static void  checkbalance(){
System.out.println("Your current balance is" + balance);
}

public static void deposit(double amount){
balance = amount + balance;
System.out.println("yonr new balance is" + balance);

}
public static void withdraw(double amount){
if(amount > balance ){
System.out.println("Insuffficient balance");
} else {
    balance = balance-amount;
System.out.println("Withdrawal successfull! new balance is" + balance);
}

}
    public static void main(String[] args) {
    Scanner input = new Scanner(System.in);
    int choice = 0;
        
    while (choice !=4){
    System.out.println("=========Welcome to ATM=====");
    System.out.println("1.Check balance");
    System.out.println("2.Deposit amount");
    System.out.println("3.withdraw");
    System.out.println("4.exit");
    System.out.println("Enter your choice");
    choice = input.nextInt();
    }
    
    switch(choice){
        case 1:
          checkbalance();
          break;
          
        case 2:
          double dep;
          System.out.println("enter amount to deposit");
          dep = input.nextDouble();
           deposit(dep);
           break;
           
        case 3:
            double draw;
        System.out.println("Enter amoun to withdraw");
        draw = input.nextDouble();
        withdraw(draw);
        break;
        
        case 4:
         System.out.println("exit");
         break;
         
        default:
            System.out.println("invalid input! try again");
    
    
    }
    input.close();
    }
}
